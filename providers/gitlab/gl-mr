#!/usr/bin/env bash
# gl-mr — read-only GitLab merge-request lookups.
#
# Why this exists: the equivalent one-liner starts with TOKEN=$(cat ~/token),
# and a command substitution cannot be prefix-matched by a permission rule, so
# Claude Code has to ask about it every single time. Behind a script name the
# whole thing becomes one plain command that `Bash(gl-mr:*)` can allow once.
#
# This script is GET-only on purpose. It has no code path that writes to GitLab,
# so allowing it is not the same as allowing `curl *` — no POST, PUT or DELETE
# can be smuggled through it.
#
# Usage:
#   gl-mr <iid>                 title, state, branches, author, truncated description
#   gl-mr <iid> meta            same as above
#   gl-mr <iid> desc            full description, untruncated
#   gl-mr <iid> json            raw MR JSON (pipe into jq for anything else)
#   gl-mr <iid> changes         changed paths with per-file +/- line counts
#   gl-mr <iid> diff            full unified diff of the MR
#   gl-mr <iid> newlines        every "path:line" that is an ADDED line in the diff
#   gl-mr <iid> commits         commit list, oldest first, all pages
#   gl-mr <iid> discussions     review threads: file, line, author, body, all pages
#   gl-mr <iid> refs            diff_refs (base/head/start SHAs) as JSON
#
# Project and host are read from `git remote get-url origin` unless GL_PROJECT
# and GL_HOST are set. Token file: GL_TOKEN_FILE, default ~/token.

set -euo pipefail

TOKEN_FILE="${GL_TOKEN_FILE:-${HOME}/token}"
DESC_MAX="${GL_DESC_MAX:-2000}"
PER_PAGE=100

die() { printf 'gl-mr: %s\n' "$*" >&2; exit 1; }

usage() {
  sed -n '/^# Usage:/,/^# Project and host/p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

case "${1:-}" in
  ''|-h|--help) usage 0 ;;
esac

iid="$1"
sub="${2:-meta}"

case "$iid" in
  *[!0-9]*) die "MR id must be a number, got '${iid}'" ;;
esac

command -v curl >/dev/null 2>&1 || die "curl not found"
command -v jq   >/dev/null 2>&1 || die "jq not found"
command -v awk  >/dev/null 2>&1 || die "awk not found"
# --fail-with-body arrived in curl 7.76. Without it a 404 body would be parsed
# as if it were data.
# Captured rather than piped: `grep -q` exits on its first match and SIGPIPEs
# the producer, and under `set -o pipefail` that 141 becomes the pipeline's
# status, so a curl that DOES support the flag can be reported as too old. Small
# output makes that unlikely here, but the shape is the bug gl-note hit for real.
curl_help="$(curl --help all 2>/dev/null || true)"
grep -q -- '--fail-with-body' <<<"$curl_help" \
  || die "curl is too old: needs 7.76+ for --fail-with-body"

# Derive project/host from the checkout so running this in the wrong repo fails
# instead of quietly querying somebody else's project.
remote_url="$(git remote get-url origin 2>/dev/null || true)"
remote_path="" remote_host=""
if [ -n "$remote_url" ]; then
  u="${remote_url%.git}"
  case "$u" in
    *://*)   remote_host="${u#*://}"; remote_host="${remote_host%%/*}"
             remote_path="${u#*://}"; remote_path="${remote_path#*/}" ;;
    *@*:*)   remote_host="${u#*@}";   remote_host="${remote_host%%:*}"
             remote_path="${u#*:}" ;;
  esac
  remote_host="${remote_host##*@}"   # strip userinfo from credentialed HTTPS URLs
fi

GL_PROJECT="${GL_PROJECT:-$remote_path}"
GL_HOST="${GL_HOST:-${remote_host:+https://$remote_host}}"
GL_HOST="${GL_HOST:-https://gitlab.com}"

[ -n "$GL_PROJECT" ] || die "cannot determine project from origin; set GL_PROJECT"

if [ -n "${GITLAB_TOKEN:-}" ]; then
  TOKEN="$GITLAB_TOKEN"
elif [ -r "$TOKEN_FILE" ]; then
  TOKEN="$(tr -d '\r\n' < "$TOKEN_FILE")"
else
  die "no token available; set GITLAB_TOKEN or GL_TOKEN_FILE"
fi
[ -n "$TOKEN" ] || die "GitLab token is empty"

curl_config="$(mktemp)"
chmod 0600 "$curl_config"
trap 'rm -f "$curl_config"' EXIT
printf 'header = "PRIVATE-TOKEN: %s"\n' "$TOKEN" > "$curl_config"
unset TOKEN

# / -> %2F so the project path survives as a single URL segment.
API="${GL_HOST}/api/v4/projects/${GL_PROJECT//\//%2F}/merge_requests/${iid}"

# The token is read from a mode-0600 curl config, never curl argv.
get() {
  curl --config "$curl_config" -sS --fail-with-body --max-time 60 \
       "${API}${1:-}" \
    || die "GET ${API}${1:-} failed"
}

# Collection endpoints default to 20 per page. Without paging, `commits` on a
# 30-commit MR silently drops the oldest ten — the end a reviewer cares about.
get_paged() {
  local path="$1" sep page=1 body n
  case "$path" in *\?*) sep='&' ;; *) sep='?' ;; esac
  while :; do
    body="$(get "${path}${sep}per_page=${PER_PAGE}&page=${page}")"
    printf '%s\n' "$body"
    n="$(printf '%s' "$body" | jq 'length')"
    [ "$n" -lt "$PER_PAGE" ] && break
    page=$((page + 1))
    [ "$page" -gt 50 ] && die "aborting after 50 pages of ${path}"
  done
}

# The /changes endpoint is deprecated since GitLab 15.7 in favour of /diffs, and
# is kept here on purpose: it is the endpoint documented to accept
# access_raw_diffs, which reads from Gitaly instead of the database and so is not
# subject to the database-backed diff size limits. For a review tool a truncated
# diff is the worst possible failure — the model reviews 60% of an MR and reports
# on all of it — so we take the raw path and still check `overflow` below.
# Revisit when API v5 removes the endpoint.
changes_json() {
  local body
  body="$(get '/changes?access_raw_diffs=true')"
  if [ "$(printf '%s' "$body" | jq -r '.overflow // false')" = "true" ]; then
    die "GitLab reports overflow=true: this diff is truncated even with access_raw_diffs. Review it in the UI or split the MR — do NOT review the partial diff."
  fi
  printf '%s' "$body"
}

# Added-line index. Everything that posts an inline note must check against this
# first: GitLab requires a position that resolves to a real line code, and an
# anchor on a context or removed line fails with
# `line_code can't be blank, must be a valid line code`.
newlines() {
  changes_json \
    | jq -r '.changes[] | "\u0001\(.new_path)", (.diff // "")' \
    | awk '
        /^\001/           { file = substr($0, 2); n = 0; next }
        file == ""        { next }
        /^@@/             { if (match($0, /\+[0-9]+/))
                              n = substr($0, RSTART + 1, RLENGTH - 1) + 0
                            next }
        # Anything before the first hunk header is file-header noise ("---",
        # "+++", "diff --git"). Skipping on n==0 rather than on a "^+++" pattern
        # matters: an added line whose content starts with "++" renders as
        # "+++..." and would otherwise be dropped, desyncing every line number
        # after it.
        n == 0            { next }
        /^\\/             { next }
        /^\+/             { print file ":" n; n++; next }
        /^-/              { next }
                          { n++ }
      '
}

case "$sub" in
  meta)
    get | jq -r --argjson max "$DESC_MAX" --arg iid "$iid" '
      "TITLE:   \(.title // "?")",
      "STATE:   \(.state // "?")   draft: \(.draft // false)",
      "BRANCH:  \(.source_branch // "?") -> \(.target_branch // "?")",
      "AUTHOR:  \(.author.name // .author.username // "?")",
      "SHA:     \(.sha // "?")",
      "URL:     \(.web_url // "?")",
      "---",
      ((.description // "") | if length > $max
          then .[0:$max] + "\n… [truncated at \($max) chars — `gl-mr \($iid) desc` prints all of it]"
          else . end)
    '
    ;;
  desc)
    get | jq -r '.description // ""'
    ;;
  json)
    get | jq .
    ;;
  refs)
    get | jq -e '.diff_refs' >/dev/null || die "MR !${iid} has no diff_refs"
    get | jq '.diff_refs'
    ;;
  changes)
    changes_json | jq -r '
      .changes[]
      | . as $c
      | ($c.diff // "" | split("\n")) as $lines
      | "\(if $c.new_file then "A" elif $c.deleted_file then "D"
           elif $c.renamed_file then "R" else "M" end) " +
        "+\([$lines[] | select(startswith("+") and (startswith("+++") | not))] | length) " +
        "-\([$lines[] | select(startswith("-") and (startswith("---") | not))] | length) " +
        "\($c.new_path)\(if $c.renamed_file then "  (was \($c.old_path))" else "" end)"
    '
    ;;
  diff)
    changes_json | jq -r '
      .changes[]
      | "=== \(.new_path) ===", (.diff // "")
    '
    ;;
  newlines)
    newlines
    ;;
  commits)
    get_paged '/commits' | jq -rs 'add // [] | reverse | .[] | "\(.short_id)  \(.author_name)  \(.title)"'
    ;;
  discussions)
    get_paged '/discussions' | jq -rs '
      (add // [])[] | select(.notes | length > 0)
      | .notes[] | select(.system == false)
      | "--- \(.author.username) on \(.position.new_path // .position.old_path // "MR")"
        + "\(if .position.new_line then ":\(.position.new_line)"
             elif .position.old_line then ":-\(.position.old_line)"
             else "" end)"
        + "\(if .resolved then "  [resolved]" else "" end)",
        (.body // ""), ""
    '
    ;;
  *)
    printf 'gl-mr: unknown subcommand %s\n\n' "$sub" >&2
    usage 2
    ;;
esac
